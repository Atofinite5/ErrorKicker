# Copy to .env and adjust. The gate reads these at boot.
GATE_PORT=3001
DATABASE_URL=postgres://kicker:kicker@localhost:5432/errorkicker
REDIS_URL=redis://localhost:6379

# Auth. Production (NODE_ENV=production) requires keys unless AUTH_REQUIRED=false.
AUTH_REQUIRED=false
WRITE_API_KEY=
REVIEW_API_KEY=
BODY_LIMIT_BYTES=262144
CORS_ORIGINS=http://localhost:3000

# LLM (Stage D12 + explanation polish). Off until you set a key and flip this.
LLM_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna

# Slack incoming webhook. Empty = skip.
SLACK_WEBHOOK_URL=
# Email: Resend and/or SMTP. Empty = skip.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=ErrorKicker <alerts@localhost>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# n8n Cloud cannot reach localhost — the gate POSTs out.
N8N_WEBHOOK_URL=
N8N_NOTIFY_STATUSES=kicked,queued

# Detection knobs
FUZZY_EMAIL_MIN=0.55
FUZZY_NAME_MIN=0.7
ANOMALY_SCORE_KICK=85

NEXT_PUBLIC_GATE_URL=http://localhost:3001
