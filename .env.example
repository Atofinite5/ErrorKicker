# Copy to .env and adjust. The gate reads these at boot.
GATE_PORT=3001
DATABASE_URL=postgres://kicker:kicker@localhost:5432/errorkicker
REDIS_URL=redis://localhost:6379

# Fix-suggestion LLM (Stage D, check 12). Off by default — the demo path is
# rule templates only, so the system works with no key and no network.
LLM_ENABLED=false
# Any OpenAI-compatible chat-completions endpoint:
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna

# Alerting: leave empty to log alerts to the console only.
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=

# n8n Cloud cannot reach localhost, so the gate POSTs out after a durable
# write. Empty = no call. Default statuses are kicked,queued (not every
# clean commit). Add committed only if you want that traffic.
N8N_WEBHOOK_URL=
N8N_NOTIFY_STATUSES=kicked,queued

# Console (Next.js) needs to know where the gate lives:
NEXT_PUBLIC_GATE_URL=http://localhost:3001
